{
  "name": "goalify-companion",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first community observations for Goalify",
  "main": "main.js",
  "scripts": { "test": "node --test tests/*.test.js", "start": "electron ." },
  "devDependencies": { "electron": "45.3.2", "electron-builder": "26.18.0" },
  "build": {
    "appId": "com.griffify.goalifycompanion",
    "productName": "Goalify Companion",
    "directories": { "output": "dist" },
    "files": ["main.js", "preload.js", "lib/**/*", "renderer/**/*", "package.json"],
    "win": { "signAndEditExecutable": false, "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "mac": { "target": ["dmg"], "category": "public.app-category.utilities" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
