{
  "name": "goalify-companion",
  "version": "0.1.6",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "Griffify Studios",
  "description": "Privacy-first community observations for Goalify",
  "main": "main.js",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "start": "electron .",
    "package:store": "powershell -NoProfile -File build\\generate-store-assets.ps1 && electron-builder --config electron-builder.store.cjs --win appx --x64 --publish never"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.griffify.goalifycompanion",
    "productName": "Goalify Companion",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "lib/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "signExecutable": false,
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.utilities"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "license": "LICENSE"
    }
  }
}
